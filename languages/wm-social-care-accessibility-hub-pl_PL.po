msgstr "Typ wpisu Lösungsweg"

#: includes/Admin/Admin_Dashboard.php:154
#, php-format
msgid ""
"%d Lösungsweg veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgid_plural ""
"%d Lösungswege veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgstr[0] ""
"Opublikowano %d wpis Lösungsweg. Shortcody wm_videothek_loesungswege i "
"wm_video_player nie wyświetlają tych wpisów, lecz osiem wbudowanych "
"przykładów."
msgstr[1] ""
"Opublikowano %d wpisy Lösungswege. Shortcody wm_videothek_loesungswege i "
"wm_video_player nie wyświetlają tych wpisów, lecz osiem wbudowanych "
"przykładów."
msgstr[2] ""
"Opublikowano %d wpisów Lösungswege. Shortcody wm_videothek_loesungswege i "
"wm_video_player nie wyświetlają tych wpisów, lecz osiem wbudowanych "
"przykładów."

