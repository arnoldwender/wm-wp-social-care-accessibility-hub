#: includes/Admin/Admin_Dashboard.php:154
#, php-format
msgid ""
"%d Lösungsweg veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgid_plural ""
"%d Lösungswege veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgstr[0] ""
"Objavljen %d Lösungsweg. Kratki kodovi wm_videothek_loesungswege i "
"wm_video_player ne prikazuju ove objave, nego osam ugrađenih primjera."
msgstr[1] ""
"Objavljena %d Lösungswege. Kratki kodovi wm_videothek_loesungswege i "
"wm_video_player ne prikazuju ove objave, nego osam ugrađenih primjera."
msgstr[2] ""
"Objavljeno %d Lösungswege. Kratki kodovi wm_videothek_loesungswege i "
"wm_video_player ne prikazuju ove objave, nego osam ugrađenih primjera."

