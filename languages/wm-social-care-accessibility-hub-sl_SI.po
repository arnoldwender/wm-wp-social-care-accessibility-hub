msgid ""
"Shortcode wm_social_care_bedarfscheck: gesetzliche Höchstbeträge nach §§ 36, "
"37, 42a und 45b SGB XI für die Pflegegrade 1 bis 5."
msgstr ""
"Kratka koda wm_social_care_bedarfscheck: zakonski najvišji zneski po §§ 36, "
"37, 42a in 45b SGB XI za stopnje oskrbe 1 do 5."

#: includes/Admin/Admin_Dashboard.php:134
msgid "Barrierefreiheits-Toolbar"
msgstr "Orodna vrstica dostopnosti"

#: includes/Admin/Admin_Dashboard.php:136
msgid "Shortcode wm_a11y_toolbar: Schriftgröße, Kontrast, Vorlesen."
msgstr "Kratka koda wm_a11y_toolbar: velikost pisave, kontrast, glasno branje."

#: includes/Admin/Admin_Dashboard.php:139
msgid "Videothek"
msgstr "Videoteka"

#: includes/Admin/Admin_Dashboard.php:141
msgid ""
"Shortcode wm_videothek_loesungswege: die acht eingebauten Beispiele "
"untereinander."
msgstr ""
"Kratka koda wm_videothek_loesungswege: osem vgrajenih primerov drug pod "
"drugim."

#: includes/Admin/Admin_Dashboard.php:144
msgid "Einzelner Player"
msgstr "Posamezni predvajalnik"

#: includes/Admin/Admin_Dashboard.php:146
msgid ""
"Shortcode wm_video_player: ein eingebautes Beispiel über das Attribut id (1 "
"bis 8)."
msgstr ""
"Kratka koda wm_video_player: en vgrajen primer prek atributa id (1 do 8)."

#: includes/Admin/Admin_Dashboard.php:149
msgid "Beitragstyp Lösungsweg"
msgstr "Vrsta objave Lösungsweg"

#: includes/Admin/Admin_Dashboard.php:154
#, php-format
msgid ""
"%d Lösungsweg veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgid_plural ""
"%d Lösungswege veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgstr[0] ""
"Objavljen %d Lösungsweg. Kratki kodi wm_videothek_loesungswege in "
"wm_video_player ne prikazujeta teh objav, temveč osem vgrajenih primerov."
msgstr[1] ""
"Objavljena %d Lösungswege. Kratki kodi wm_videothek_loesungswege in "
"wm_video_player ne prikazujeta teh objav, temveč osem vgrajenih primerov."
msgstr[2] ""
"Objavljeni %d Lösungswege. Kratki kodi wm_videothek_loesungswege in "
"wm_video_player ne prikazujeta teh objav, temveč osem vgrajenih primerov."
msgstr[3] ""
"Objavljenih %d Lösungswege. Kratki kodi wm_videothek_loesungswege in "
"wm_video_player ne prikazujeta teh objav, temveč osem vgrajenih primerov."

