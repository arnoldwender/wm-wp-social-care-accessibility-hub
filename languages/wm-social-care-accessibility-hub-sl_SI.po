#: includes/Admin/Admin_Dashboard.php:124
msgid "Leichte-Sprache-Karte"
msgstr "Kartica v lahkem branju"

#: includes/Admin/Admin_Dashboard.php:126
msgid ""
"Shortcode wm_leichte_sprache_card mit Mediopunkt-Trennung für Fachbegriffe."
msgstr ""
"Kratka koda wm_leichte_sprache_card z delitvijo strokovnih izrazov s "
"sredinsko piko."

