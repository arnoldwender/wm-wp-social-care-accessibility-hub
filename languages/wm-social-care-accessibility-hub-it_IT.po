msgid "Alle acht eingebauten Beispiel-Lösungswege untereinander, ohne Filter."
msgstr "Tutti gli otto esempi integrati elencati senza filtri."

#: includes/Admin/Admin_Dashboard.php:178
msgid ""
"Ein eingebautes Beispiel mit Schritten und Zusammenfassung in Leichter "
