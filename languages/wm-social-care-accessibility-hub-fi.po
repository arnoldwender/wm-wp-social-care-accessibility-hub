msgstr "Lyhytkoodi wm_a11y_toolbar: tekstikoko, kontrasti, ääneenlukeminen."

#: includes/Admin/Admin_Dashboard.php:139
msgid "Videothek"
msgstr "Videokirjasto"

#: includes/Admin/Admin_Dashboard.php:141
msgid ""
"Shortcode wm_videothek_loesungswege: die acht eingebauten Beispiele "
"untereinander."
msgstr ""
"Lyhytkoodi wm_videothek_loesungswege: kahdeksan sisäänrakennettua esimerkkiä "
"allekkain."

#: includes/Admin/Admin_Dashboard.php:144
msgid "Einzelner Player"
msgstr "Yksittäinen soitin"

#: includes/Admin/Admin_Dashboard.php:146
msgid ""
"Shortcode wm_video_player: ein eingebautes Beispiel über das Attribut id (1 "
"bis 8)."
msgstr ""
"Lyhytkoodi wm_video_player: yksi sisäänrakennettu esimerkki id-attribuutilla "
"(1–8)."

#: includes/Admin/Admin_Dashboard.php:149
msgid "Beitragstyp Lösungsweg"
msgstr "Sisältötyyppi Lösungsweg"

#: includes/Admin/Admin_Dashboard.php:154
#, php-format
msgid ""
"%d Lösungsweg veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgid_plural ""
"%d Lösungswege veröffentlicht. Die Shortcodes wm_videothek_loesungswege und "
"wm_video_player zeigen nicht diese Beiträge, sondern acht eingebaute "
"Beispiele."
msgstr[0] ""
"%d Lösungsweg julkaistu. Lyhytkoodit wm_videothek_loesungswege ja "
"wm_video_player eivät näytä näitä julkaisuja vaan kahdeksan "
"sisäänrakennettua esimerkkiä."
msgstr[1] ""
"%d Lösungswege julkaistu. Lyhytkoodit wm_videothek_loesungswege ja "
"wm_video_player eivät näytä näitä julkaisuja vaan kahdeksan "
"sisäänrakennettua esimerkkiä."

#: includes/Admin/Admin_Dashboard.php:174
msgid ""
"Auswahl des Pflegegrads mit den gesetzlichen Höchstbeträgen (Stand der "
"Beträge im Code)."
msgstr ""
"Hoitoisuusluokan valinta lakisääteisillä enimmäismäärillä (päiväys koodissa)."

#: includes/Admin/Admin_Dashboard.php:175
msgid ""
"Content-Box in Leichter Sprache mit Mediopunkt; Attribute title und "
"pictogram, Inhalt zwischen den Tags."
msgstr ""
"Selkokielinen sisältölaatikko Mediopunkt-merkinnällä; attribuutit title ja "
"pictogram, sisältö tunnisteiden välissä."

